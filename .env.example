## Ambiente
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

## Banco de dados
DATABASE_URL=sqlite:///./data/app.db

## LLM (desacoplado - stub funciona sem chave/API externa)
# Providers suportados: stub | local | anthropic | openai
# scripts/setup_local_llm.ps1 ajusta LLM_PROVIDER e LOCAL_LLM_MODEL_PATH
# automaticamente ao instalar o llama.cpp + modelo local.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=

## LLM local via gpt4all (100% offline, sem filtro de conteudo). Roda no
## CPU por padrao (LOCAL_LLM_DEVICE=cpu) para nao disputar VRAM com o
## ComfyUI na mesma GPU de 4 GB. ctx/max_tokens conservadores de proposito
## -- geracao no CPU e sensivel a esses valores; aumentar deixa as
## respostas mais completas, mas mais lentas.
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_CTX_SIZE=2048
LOCAL_LLM_THREADS=0
LOCAL_LLM_DEVICE=cpu
LOCAL_LLM_MAX_TOKENS=150
LOCAL_LLM_TEMPERATURE=0.8

## Hardware (preenchido por scripts/audit_env.py quando detectável; nunca
## presuma NVIDIA -- vendor suportados: nvidia | amd | intel | cpu | UNKNOWN)
GPU_VENDOR=UNKNOWN
GPU_MODEL=UNKNOWN
GPU_VRAM_GB=UNKNOWN
GPU_BACKEND=UNKNOWN
GPU_DRIVER_VERSION=UNKNOWN
CUDA_VERSION=UNKNOWN

## Gerador de mídia (desacoplado do restante da aplicação)
# Providers suportados: null | comfyui
# scripts/setup_comfyui.ps1 ajusta estas 3 linhas automaticamente ao
# instalar o ComfyUI + checkpoint. Deixe MEDIA_PROVIDER=null até rodá-lo.
MEDIA_PROVIDER=null
COMFYUI_URL=http://127.0.0.1:8188
IMAGE_MODEL_PATH=

## Parâmetros de geração (padrões conservadores para 4 GB de VRAM; batch
## size é sempre 1 e não é configurável aqui -- ver HARDWARE.md)
COMFYUI_WIDTH=512
COMFYUI_HEIGHT=512
COMFYUI_STEPS=20
COMFYUI_CFG=7.0
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal
COMFYUI_NEGATIVE_PROMPT=
COMFYUI_TIMEOUT_SECONDS=180

## Armazenamento
GENERATED_DIR=./generated
LOGS_DIR=./logs

## CORS (frontend local)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
