## Ambiente
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

## Banco de dados
DATABASE_URL=sqlite:///./data/app.db

## LLM (desacoplado - stub funciona sem chave/API externa)
# Providers suportados: stub | anthropic | openai
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=

## Hardware (preenchido por scripts/audit_env.py quando detectável; nunca
## presuma NVIDIA -- vendor suportados: nvidia | amd | intel | cpu | UNKNOWN)
GPU_VENDOR=UNKNOWN
GPU_MODEL=UNKNOWN
GPU_VRAM_GB=UNKNOWN
GPU_BACKEND=UNKNOWN
GPU_DRIVER_VERSION=UNKNOWN
CUDA_VERSION=UNKNOWN

## Gerador de mídia (desacoplado do restante da aplicação)
# Providers suportados: null | comfyui
MEDIA_PROVIDER=null
COMFYUI_URL=http://127.0.0.1:8188
IMAGE_MODEL_PATH=

## Armazenamento
GENERATED_DIR=./generated
LOGS_DIR=./logs

## CORS (frontend local)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
